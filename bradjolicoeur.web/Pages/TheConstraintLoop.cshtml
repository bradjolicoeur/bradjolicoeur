@page "/books/the-constraint-loop"
@model TheConstraintLoopModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.PageData?.Title ?? "The Constraint Loop | A Novel of AI, Flow, and Trust";
    ViewBag.Description = Model.PageData?.Description ?? "A business novel about AI-driven software delivery, trust, and flow—ideal for engineering leaders, CTOs, and Theory of Constraints readers.";
    ViewBag.Image = Model.PageData?.HeroImageUrl;
}

<style>
    .book-landing {
        max-width: 860px;
        margin: 0 auto;
        padding: 0 1.5rem 4rem;
        color: #222;
        font-family: 'Inter', sans-serif;
    }

    .book-hero {
        text-align: center;
        padding: 3rem 0 2rem;
    }

    .book-hero img {
        max-width: 320px;
        width: 100%;
        height: auto;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
        border-radius: 4px;
        margin-bottom: 2rem;
    }

    .book-hero h1 {
        font-size: 2.4rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        letter-spacing: -0.01em;
    }

    .book-hero p {
        font-size: 1.15rem;
        color: #555;
        margin-bottom: 0;
    }

    .book-body {
        line-height: 1.7;
        font-size: 1.05rem;
    }

    .book-body h2 {
        margin-top: 3rem;
        font-weight: 700;
        font-size: 1.6rem;
    }

    .book-body h3 {
        margin-top: 2rem;
        font-weight: 600;
        font-size: 1.2rem;
    }

    .book-body blockquote {
        border-left: 3px solid #ccc;
        margin-left: 0;
        padding-left: 1rem;
        color: #555;
        font-style: italic;
    }

    .book-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        margin: 1.5rem 0;
    }

    .book-cta a {
        display: inline-block;
        padding: 0.7rem 1.4rem;
        border-radius: 4px;
        background: #1a1a1a;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .book-cta a:hover {
        background: #333;
    }

    .book-coming-soon {
        display: block;
        width: fit-content;
        margin: 1.5rem auto;
        padding: 0.6rem 1.6rem;
        border: 1px solid #1a1a1a;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        text-align: center;
    }

    @@media (max-width: 600px) {
        .book-hero h1 {
            font-size: 1.9rem;
        }
    }
</style>

<div class="book-landing">
    <section class="book-hero">
        @if (!string.IsNullOrEmpty(Model.PageData?.HeroImageUrl))
        {
            <img src="@Model.PageData.HeroImageUrl" alt="The Constraint Loop cover" />
        }
        <h1>@(Model.PageData?.HeroTitle ?? "The Constraint Loop")</h1>
        <p>@(Model.PageData?.HeroPhrase ?? "A Novel of AI, Flow, and Trust")</p>
    </section>

    <div class="book-body">
        @Html.Raw(MarkdownHelper.Transform(Model.PageData?.Body))
    </div>
</div>
